DEVEL_PATH_ARCH_DELIMETER="."
RPM_HELPERS_DIR="/usr/lib/rpm/azl"
KERNEL_DEBUGINFO="kernel-debugsource-${lnxmaj}-${lnxrel}.${TARGET_ARCH}.rpm"

# Force %dist in ~/.rpmmacros to keep RPM names consistent with Azure Linux
RMAC=$HOME/.rpmmacros

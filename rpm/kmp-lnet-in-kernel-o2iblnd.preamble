Summary:        Lustre LNet o2iblnd for in-kernel OFED
License:        GPL-2.0-only
# Azure Linux 3: kmodtool hardcodes /usr/sbin/depmod which doesn't exist on AL3.
# The kmodtool wrapper filters that dependency; require kmod explicitly for depmod.
%if 0%{?azurelinux}
Requires:       kmod
%endif
%if 0%{?suse_version} > 1
Requires:       kernel-%1
%endif
Provides:       %{name}-lnet-in-kernel-o2iblnd = %{version}
Obsoletes:      %{name}-lnet-in-kernel-o2iblnd < %{version}
# Common package name
Provides:       %{name}-lnet-o2iblnd = %{version}
Obsoletes:      %{name}-lnet-o2iblnd < %{version}
